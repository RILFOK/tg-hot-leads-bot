generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  WAITING_REPLY
  IN_PROGRESS
  WON
  LOST
  IGNORED
  DELETED
}

enum LeadCategory {
  SITE
  LANDING
  SHOP
  SUPPORT
  UNKNOWN
}

enum UserRole {
  OWNER
  USER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum LeadDeliveryType {
  OWNER_GLOBAL
  USER_TRIGGER
}

enum PaymentProvider {
  TELEGRAM_STARS
  YOOKASSA
  ROBOKASSA
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
  EXPIRED
  REFUNDED
}

model Lead {
  id String @id @default(cuid())

  // Изолирует глобальные лиды владельца от персональных лидов.
  // Новые значения: OWNER или USER:<BotUser.id>.
  // LEGACY используется для существующих записей.
  scopeKey String @default("LEGACY")

  sourceChatId     String
  sourceChatTitle  String
  sourceMessageId  Int
  messageText      String
  matchedKeywords  String[]
  negativeKeywords String[]
  score            Int
  category         LeadCategory @default(UNKNOWN)

  authorTelegramId String?
  authorUsername   String?
  authorName       String?

  messageUrl String?
  note       String?

  adminChatId    String?
  adminMessageId Int?

  triggerCount    Int      @default(1)
  lastTriggeredAt DateTime @default(now())

  status LeadStatus @default(NEW)

  deliveries LeadDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceChatId, sourceMessageId, scopeKey])
  @@index([scopeKey, authorTelegramId, status, lastTriggeredAt])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([authorTelegramId])
  @@index([lastTriggeredAt])
  @@index([adminChatId, adminMessageId])
}

model BannedUser {
  id         String  @id @default(cuid())
  telegramId String  @unique
  username   String?
  name       String?
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlackWord {
  id        String   @id @default(cuid())
  phrase    String   @unique
  createdAt DateTime @default(now())
}

model SourceChat {
  chatId    String  @id
  title     String
  isBlocked Boolean @default(false)

  users UserSourceChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotUser {
  id         String  @id @default(cuid())
  telegramId String  @unique
  username   String?
  firstName  String?
  lastName   String?

  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  // Чат, в который пользователь получает свои уведомления.
  deliveryChatId String?

  subscription Subscription?
  triggers     UserTrigger[]
  sourceChats  UserSourceChat[]
  deliveries   LeadDelivery[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  planCode String             @default("TRIAL")
  status   SubscriptionStatus @default(TRIAL)

  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  autoRenew Boolean   @default(false)

  user BotUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id     String @id @default(cuid())
  userId String

  provider PaymentProvider
  status   PaymentStatus   @default(CREATED)

  // Покупаемый тариф и срок доступа.
  planCode     String
  durationDays Int    @default(30)

  // Для RUB сумма хранится в копейках.
  // Для XTR значение равно количеству Telegram Stars.
  amountMinor Int
  currency    String

  // ID платежа у Telegram, ЮKassa или Robokassa.
  providerPaymentId String?

  // Внутренний ключ предотвращает повторное создание заказа.
  idempotencyKey String @unique

  confirmationUrl String?

  // После этого времени новый платёж по заказу не принимается.
  expiresAt DateTime

  paidAt      DateTime?
  activatedAt DateTime?
  refundedAt  DateTime?

  failureReason String?
  metadata      Json?

  user   BotUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([provider, status])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id        String  @id @default(cuid())
  paymentId String?

  provider PaymentProvider

  // Вычисляемый уникальный ключ входящего события:
  // Telegram: successful_payment:<charge_id>
  // ЮKassa: <event_type>:<payment_id>
  // Robokassa: result:<InvId>:<OutSum>
  externalEventKey String
  eventType        String

  payload Json

  processedAt     DateTime?
  processingError String?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, externalEventKey])
  @@index([paymentId, createdAt])
  @@index([provider, processedAt])
}

model UserTrigger {
  id     String @id @default(cuid())
  userId String

  phrase           String
  normalizedPhrase String
  isActive         Boolean @default(true)

  user BotUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, normalizedPhrase])
  @@index([userId, isActive])
}

model UserSourceChat {
  id     String @id @default(cuid())
  userId String
  chatId String

  // Отключение источника влияет только на персональные уведомления.
  // Глобальный детектор сайтов владельца продолжает работать.
  isActive Boolean @default(true)

  user       BotUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChat SourceChat @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([chatId, isActive])
}

model LeadDelivery {
  id     String @id @default(cuid())
  leadId String

  recipientUserId String?
  recipientChatId String

  deliveryType LeadDeliveryType

  // Пользовательские триггеры, вызвавшие доставку.
  // Для OWNER_GLOBAL массив остаётся пустым.
  matchedTriggers String[]

  telegramMessageId Int?

  // Личный статус и заметка конкретного получателя.
  // Не изменяют глобальный Lead.status владельца.
  status LeadStatus @default(NEW)
  note   String?

  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientUser BotUser? @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Один лид не отправляется дважды в один чат.
  @@unique([leadId, recipientChatId])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, status, updatedAt])
  @@index([deliveryType])
}
